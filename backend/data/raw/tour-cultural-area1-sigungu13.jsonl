"scale":"","usefee":"무료","discountinfo":"","spendtime":"","parkingfee":"","infocenterculture":"02-325-7216","accomcountculture":"","usetimeculture":"10:00~17:00","restdateculture":"매주 토요일, 일요일 / 법정공휴일","parkingculture":"가능","chkbabycarriageculture":"","chkpetculture":"","chkcreditcardculture":""},"info":[],"_fetched_at":"2026-05-24T08:46:53.105Z"}
