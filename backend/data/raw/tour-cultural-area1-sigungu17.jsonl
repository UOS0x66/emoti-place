time":"","parkingfee":"5시간까지 3,000원","infocenterculture":"02-940-4232","accomcountculture":"","usetimeculture":"- 월요일~금요일 10:00~17:00<br>\n- 방학기간 10:30~15:00","restdateculture":"매주 토요일~일요일 / 법정공휴일","parkingculture":"가능","chkbabycarriageculture":"","chkpetculture":"","chkcreditcardculture":""},"info":[{"contentid":"1628531","contenttypeid":"14","serialnum":"0","infoname":"체험프로그램","infotext":"전시해설 프로그램(5월) / 여성·인문·미술 관련 강연<br>\n※ 자세한 사항은 홈페이지 확인","fldgubun":"1"}],"_fetched_at":"2026-04-27T07:47:16.505Z"}
