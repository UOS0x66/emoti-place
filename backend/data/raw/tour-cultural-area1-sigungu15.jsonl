gfee":"","infocenterculture":"02-3452-8182","accomcountculture":"","usetimeculture":"10:00~17:00 (휴게시간 12:00~13:00)","restdateculture":"연중무휴","parkingculture":"불가능","chkbabycarriageculture":"","chkpetculture":"","chkcreditcardculture":""},"info":[{"contentid":"231962","contenttypeid":"14","serialnum":"0","infoname":"체험프로그램","infotext":"튀르키예 가정식 원데이&정규 클래스 / 모자이크램프 원데이 클래스 / 터키쉬 이즈닉 도자기 페인팅 원데이&정규 클래스 등","fldgubun":"1"}],"_fetched_at":"2026-05-24T08:48:23.315Z"}
{"contentid":"130951","contenttypeid":"14","list":{"addr1":"서울특별시 서초구 효령로72길 60 (서초동)","addr2":"","areacode":"1","cat1":"A02","cat2":"A0206","cat3":"A02060100","contentid":"130951","contenttypeid":"14","createdtime":"20070806090000","firstimage":"http://tong.visitkorea.or.kr/cms/resource/11/3540611_image2_1.jpg","firstimage2":"http://tong.visitkorea.or.kr/cms/resource/11/3540611_image3_1.jpg","cpyrhtDivCd":"Type1","mapx":"127.0280882379","mapy":"37.4856423108","mlevel":"6","modifiedtime":"20250918110444","sigungucode":"15","tel":"","title":"전기박물관","zipcode":"06732","lDongRegnCd":"11","lDongSignguCd":"650","lclsSystm1":"VE","lclsSystm2":"VE07","lclsSystm3":"VE070100"},"common":{"contentid":"130951","contenttypeid":"14","title":"전기박물관","createdtime":"20070806090000","modifiedtime":"20250918110444","tel":"","telname":"","homepage":"<a href=\"https://www.kepco.co.kr/art/space/museum/museumList.do\" target=\"_blank\" title=\"새창 : 한전아트센터 홈페이지로 이동\">https://www.kepco.co.kr/art</a>","firstimage":"http://tong.visitkorea.or.kr/cms/resource/11/3540611_image2_1.jpg","firstimage2":"http://tong.visitkorea.or.kr/cms/resource/11/3540611_image3_1.jpg","cpyrhtDivCd":"Type1","areacode":"1","sigungucode":"15","lDongRegnCd":"11","lDongSignguCd":"650","lclsSystm1":"VE","lclsSystm2":"VE07","lclsSystm3":"VE070100","cat1":"A02","cat2":"A0206","cat3":"A02060100","addr1":"서울특별시 서초구 효령로72길 60 (서초동)","addr2":"","zipcode":"06732","mapx":"127.0280882379","mapy":"37.4856423108","mlevel":"6","overview":"한국전력은 1887년 경복궁에 처음으로 전기불이 켜진 이후 일제의 강점과 남북분단, 그리고 한국전쟁이라는 민족상잔의 아픔을 국민들과 함께 이겨내면서 오늘날 우리 사회의 중추적인 기간산업으로 자리하게 되었다. 20세기 격변하는 역사의 소용돌이 속에서도 꾸준히 성장을 거듭하여 국가경제 발전의 원동력이 되어온 한국전력은 국가경제와 고객에 대한 무한 책임과 전력문화 창달을 위하여 끊임없이 노력하고 있다.\n한국전력은 지난 세기의 전기역사를 체계적으로 정리하여 보존하고 사람들에게 전기의 소중함과 근대 과학의 발전과정을 알려주기 위해 전기박물관을 건립했다. 전기박물관은 전력인의 혼이 담긴 소중한 전력문화유산을 후손에게 물려주고자 하는 전력인의 바람이다."},"intro":{"contentid":"130951","contenttypeid":"14","scale":"","usefee":"무료","discountinfo":"","spendtime":"","parkingfee":"관람객에게 한하여 2시간 무료 주차","infocenterculture":"02-2105-8190","accomcountculture":"","usetimeculture":"화요일~토요일 10:00~17:30","restdateculture":"매주 일요일~월요일 / 법정공휴일","parkingculture":"가능","chkbabycarriageculture":"","chkpetculture":"","chkcreditcardculture":""},"info":[],"_fetched_at":"2026-05-24T08:48:23.606Z"}
