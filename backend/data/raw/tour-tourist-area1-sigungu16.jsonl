"heritage3":"0","infocenter":"02-2153-0400","opendate":"","restdate":"매주 일요일","expguide":"새활용아카데미 / 꿈꾸는 공장","expagerange":"","accomcount":"","useseason":"","usetime":"10:00~18:00<br>\n※ 토요일의 경우, 소재은행은 새활용 탐방, 공간 및 장비사용 신청 사전 예약자에 한하여 방문 가능","parking":"가능","chkbabycarriage":"없음","chkpet":"","chkcreditcard":"없음"},"info":[{"contentid":"2553908","contenttypeid":"12","serialnum":"0","infoname":"입 장 료","infotext":"무료","fldgubun":"3"}],"_fetched_at":"2026-04-27T07:52:54.225Z"}
