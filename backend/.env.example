PORT=3000

# DB: 로컬 PostgreSQL이거나, 미설치 환경에서는 `npm run pglite` (127.0.0.1:5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Chroma: src/config/chroma.js 가 host/port 분리해서 읽음
CHROMA_HOST=localhost
CHROMA_PORT=8000

# LLM (Stage 1/2 structured outputs 지원 모델)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Stage 1 RAG 청크 (cwd 기준 상대경로 — backend dir에서 실행할 때만 동작)
PSYCH_CHUNKS_PATH=data/psych/processed/chunks.jsonl

JWT_SECRET=change-this-secret-in-production

# ETL: 공공데이터포털 TourAPI 인증키 (디코딩된 키)
# 발급: https://www.data.go.kr/data/15101578/openapi.do
TOUR_API_SERVICE_KEY=
